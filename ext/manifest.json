{
  "manifest_version": 3,
  "name": "Jobber - Smart Job Saver",
  "version": "1.1.3",
  "description": "Save jobs from any site to Jobber in one click — AI parsing, resume-to-job match score, and one-tap application autofill.",
  "minimum_chrome_version": "114",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "alarms",
    "contextMenus",
    "sidePanel"
  ],
  "host_permissions": [
    "https://jobber-app.com/*",
    "http://localhost:8080/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "commands": {
    "save-job": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Save current page as a job to Jobber"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://www.indeed.com/*",
        "https://www.glassdoor.com/Job/*",
        "https://www.glassdoor.co.uk/Job/*"
      ],
      "js": ["content/jobboards.js"],
      "css": ["content/jobboards.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.myworkdaysite.com/*",
        "https://*.breezy.hr/*",
        "https://*.ashbyhq.com/*",
        "https://*.smartrecruiters.com/*",
        "https://*.icims.com/*",
        "https://*.applytojob.com/*",
        "https://*.bamboohr.com/*",
        "https://www.linkedin.com/jobs/*",
        "https://www.indeed.com/*"
      ],
      "js": ["content/autofill.js"],
      "css": ["content/autofill.css"],
      "run_at": "document_idle"
    }
  ]
}
