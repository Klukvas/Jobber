# Server
SERVER_PORT=8080
SERVER_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=jobber
DB_PASSWORD=jobber
DB_NAME=jobber
DB_SSL_MODE=disable
DB_MAX_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_ACCESS_SECRET=your-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# CORS (comma-separated origins, "*" for development only)
ALLOWED_ORIGINS=*

# Internal frontend URL for server-to-server calls, e.g. React-based PDF rendering
# (in Docker this is the service name, e.g. http://frontend). Falls back to Go
# templates if empty. Do NOT use this for public links — it's not internet-reachable.
FRONTEND_URL=

# Public origin the *customer's browser* can reach, e.g. https://jobber-app.com.
# Used to build shareable/OG links (og:image, og:url) that social crawlers fetch
# from the internet, and the password-reset email's "Set a new password" button.
# Must be an absolute http(s) URL; anything else is refused at startup. If empty,
# defaults to the first ALLOWED_ORIGINS entry, then to https://jobber-app.com.
# Never FRONTEND_URL — that is the internal Docker host and nothing outside the
# network can open it.
PUBLIC_BASE_URL=
# Comma-separated IPs/CIDRs of the reverse proxies in front of the API (e.g. the
# Docker network the proxy runs in). Only their X-Forwarded-For is honoured when
# working out the client IP for rate limiting. Empty keeps gin's default of
# trusting every proxy, which lets a caller rotate the header to dodge per-IP
# limits — set it in production once you know the proxy's address.
TRUSTED_PROXIES=

# S3 Storage (Hetzner Object Storage)
S3_ENDPOINT=https://nbg1.your-objectstorage.com
S3_BUCKET=jobber-resumes
S3_REGION=eu-central
S3_ACCESS_KEY=your_access_key_here
S3_SECRET_KEY=your_secret_key_here

# Anthropic AI (optional — enables job import parsing and match score)
ANTHROPIC_API_KEY=

# Google Calendar (optional — all 5 must be set to enable)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URL=
GOOGLE_CALENDAR_FRONTEND_URL=
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=

# Sentry (optional — empty DSN disables error tracking)
SENTRY_DSN=
SENTRY_RELEASE=

# Resend (optional — empty API key uses no-op email sender)
RESEND_API_KEY=
RESEND_FROM_ADDRESS=Jobber <noreply@jobber-app.com>

# Telegram (optional — enables support ticket forwarding)
TELEGRAM_BOT_TOKEN=
TELEGRAM_SUPPORT_CHAT_ID=

# Creem (optional — required when FEATURE_PAYMENTS_ENABLED=true)
# Checkout is a redirect to Creem's hosted page; there is no on-page script.
# Test and live use DIFFERENT API keys, webhook secrets and product ids —
# switch them together with CREEM_ENVIRONMENT.
# API key: Creem dashboard > Developers > API Keys. Required whenever
# FEATURE_PAYMENTS_ENABLED=true — the server refuses to start without it.
CREEM_API_KEY=
# Signing secret of the webhook endpoint: Developers > Webhooks, add the endpoint
# https://<host>/api/v1/webhooks/creem and copy its signing secret (HMAC SHA256,
# header creem-signature). Required whenever FEATURE_BILLING_WEBHOOK_ENABLED
# resolves to true — the server refuses to start without it rather than rejecting
# every delivery in silence.
CREEM_WEBHOOK_SECRET=
# test (https://test-api.creem.io) or live (https://api.creem.io). Must match
# the kind of API key above.
CREEM_ENVIRONMENT=test
# Product ids from the Creem Products page (prod_xxx), one per paid plan.
# No defaults: an empty value means that plan is not purchasable. At least one is
# required whenever FEATURE_PAYMENTS_ENABLED or FEATURE_BILLING_WEBHOOK_ENABLED
# resolves to true — ingestion needs them to tell which plan an event grants.
CREEM_PRO_PRODUCT_ID=
CREEM_ENTERPRISE_PRODUCT_ID=

# Feature flags
FEATURE_SENTRY_ENABLED=true
FEATURE_EMAIL_ENABLED=true
# Gates new purchases and self-service plan management.
FEATURE_PAYMENTS_ENABLED=false
# Gates webhook ingestion. Leave EMPTY to follow FEATURE_PAYMENTS_ENABLED, which is
# what makes a local billing-off checkout boot with no Creem config at all.
# Set it to true explicitly to keep recording renewals, cancellations and
# deactivations for existing subscribers while the checkout is closed — that
# combination needs CREEM_WEBHOOK_SECRET or the server will not start.
FEATURE_BILLING_WEBHOOK_ENABLED=
