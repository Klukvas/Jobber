# Server
SERVER_PORT=8080
SERVER_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=jobber
DB_PASSWORD=jobber
DB_NAME=jobber
DB_SSL_MODE=disable
DB_MAX_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_ACCESS_SECRET=your-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# CORS (comma-separated origins, "*" for development only)
ALLOWED_ORIGINS=*

# Internal frontend URL for server-to-server calls, e.g. React-based PDF rendering
# (in Docker this is the service name, e.g. http://frontend). Falls back to Go
# templates if empty. Do NOT use this for public links — it's not internet-reachable.
FRONTEND_URL=

# Public origin used to build shareable/OG links (og:image, og:url) that social
# crawlers fetch from the internet, e.g. https://jobber-app.com. If empty, defaults
# to the first ALLOWED_ORIGINS entry.
PUBLIC_BASE_URL=

# S3 Storage (Hetzner Object Storage)
S3_ENDPOINT=https://nbg1.your-objectstorage.com
S3_BUCKET=jobber-resumes
S3_REGION=eu-central
S3_ACCESS_KEY=your_access_key_here
S3_SECRET_KEY=your_secret_key_here

# Anthropic AI (optional — enables job import parsing and match score)
ANTHROPIC_API_KEY=

# Google Calendar (optional — all 5 must be set to enable)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URL=
GOOGLE_CALENDAR_FRONTEND_URL=
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=

# Sentry (optional — empty DSN disables error tracking)
SENTRY_DSN=
SENTRY_RELEASE=

# Resend (optional — empty API key uses no-op email sender)
RESEND_API_KEY=
RESEND_FROM_ADDRESS=Jobber <noreply@jobber-app.com>

# Telegram (optional — enables support ticket forwarding)
TELEGRAM_BOT_TOKEN=
TELEGRAM_SUPPORT_CHAT_ID=

# FastSpring (optional — required when FEATURE_PAYMENTS_ENABLED=true)
# API credentials: FastSpring app > Developer Tools > API Credentials (HTTP Basic pair).
FASTSPRING_API_USERNAME=
FASTSPRING_API_PASSWORD=
# HMAC SHA256 secret configured on the webhook endpoint (Developer Tools > Webhooks).
# Required whenever FEATURE_BILLING_WEBHOOK_ENABLED resolves to true — the server
# refuses to start without it rather than rejecting every delivery in silence.
FASTSPRING_WEBHOOK_SECRET=
# Dashboard checkout the Sessions API creates sessions against. Exactly
# "<storefront-id>/<checkout-id>" — two segments, no leading or trailing slash.
# It must be a *popup* checkout (Storefronts > Popup Storefront > checkout id),
# so the second segment starts with "popup-": checkout opens in the FastSpring
# Store Builder Library popup, and a full-page Web Checkout id would open onto
# nothing. Example: fluxlab/popup-jobber, or generically store/popup-name.
# The popup storefront the browser loads is derived from this value and
# FASTSPRING_ENVIRONMENT (test -> <store>.test.onfastspring.com/<checkout-id>,
# live -> <store>.onfastspring.com/<checkout-id>), so there is nothing to keep
# in sync by hand. Validated at startup, not escaped: anything else fails the boot.
FASTSPRING_CHECKOUT_PATH=
# test or live — must match the "Get webhooks from" setting on the webhook.
FASTSPRING_ENVIRONMENT=test
# Catalog product paths for each paid plan.
FASTSPRING_PRO_PRODUCT_PATH=jobber-pro
FASTSPRING_ENTERPRISE_PRODUCT_PATH=jobber-enterprise

# Feature flags
FEATURE_SENTRY_ENABLED=true
FEATURE_EMAIL_ENABLED=true
# Gates new purchases and self-service plan management.
FEATURE_PAYMENTS_ENABLED=false
# Gates webhook ingestion. Leave EMPTY to follow FEATURE_PAYMENTS_ENABLED, which is
# what makes a local billing-off checkout boot with no FastSpring config at all.
# Set it to true explicitly to keep recording renewals, cancellations and
# deactivations for existing subscribers while the checkout is closed — that
# combination needs FASTSPRING_WEBHOOK_SECRET or the server will not start.
FEATURE_BILLING_WEBHOOK_ENABLED=
