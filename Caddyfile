jobber-app.com {
	header {
		# HSTS — force HTTPS for 1 year, include subdomains
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

		# Prevent clickjacking
		X-Frame-Options "SAMEORIGIN"

		# Block MIME-type sniffing
		X-Content-Type-Options "nosniff"

		# CSP — allow self, Google Fonts, Sentry and inline styles (Tailwind).
		# Checkout is a full-page redirect to Creem's hosted page, so it needs no
		# script/frame/connect allowances here.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://nbg1.your-objectstorage.com https://*.ingest.sentry.io; form-action 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"

		# Referrer policy
		Referrer-Policy "strict-origin-when-cross-origin"

		# Permissions policy — disable unused browser features. No embedded payment
		# frame exists (checkout is a redirect), so `payment` needs no allowance.
		Permissions-Policy "camera=(), microphone=(), geolocation=()"

		# Remove server header
		-Server
	}

	reverse_proxy frontend:80
}
