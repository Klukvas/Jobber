(security_headers) {
	header {
		# HSTS — force HTTPS for 1 year, include subdomains
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

		# Prevent clickjacking
		X-Frame-Options "SAMEORIGIN"

		# Block MIME-type sniffing
		X-Content-Type-Options "nosniff"

		# CSP — allow self, Google Fonts, Sentry and inline styles (Tailwind).
		# Checkout is a full-page redirect to Creem's hosted page, so it needs no
		# script/frame/connect allowances here.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://nbg1.your-objectstorage.com https://*.ingest.sentry.io https://cloudflareinsights.com; form-action 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"

		# Referrer policy
		Referrer-Policy "strict-origin-when-cross-origin"

		# Permissions policy — disable unused browser features. No embedded payment
		# frame exists (checkout is a redirect), so `payment` needs no allowance.
		Permissions-Policy "camera=(), microphone=(), geolocation=()"

		# Remove server header
		-Server
	}
}

cursopus.com {
	import security_headers
	reverse_proxy frontend:80
}

# www -> apex redirect. Caddy obtains a cert for www so Cloudflare (Full strict)
# does not return 525. Requires the Cloudflare DNS record for www to be proxied
# and pointing at this origin.
www.cursopus.com {
	redir https://cursopus.com{uri} permanent
}

# Legacy domain (Jobber -> Cursopus rename). Pages 301 to the new domain; /api/*
# keeps working because already-installed extension versions have this host
# hard-coded as their API base, and Creem may still deliver webhooks here.
# Remove the /api/* handler only once no traffic reaches it (see
# docs/plans/rebrand-cursopus.md, phase 4).
jobber-app.com {
	import security_headers

	handle /api/* {
		reverse_proxy frontend:80
	}

	handle {
		redir https://cursopus.com{uri} permanent
	}
}

www.jobber-app.com {
	redir https://cursopus.com{uri} permanent
}
