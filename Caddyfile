{
	servers {
		# Only Cloudflare's edge may name the client: every other peer is taken at
		# its socket address, whatever headers it sends. A range missing here is
		# not dangerous, that edge's traffic is just limited per edge again.
		# Published at https://www.cloudflare.com/ips/, kept in step by
		# .github/workflows/cloudflare-ips.yml.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

(security_headers) {
	header {
		# HSTS — force HTTPS for 1 year, include subdomains
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

		# Prevent clickjacking
		X-Frame-Options "SAMEORIGIN"

		# Block MIME-type sniffing
		X-Content-Type-Options "nosniff"

		# CSP — allow self, Google Fonts, Sentry, consent-gated analytics and inline
		# styles (Tailwind). Checkout is a full-page redirect to Creem's hosted page,
		# so it needs no script/frame/connect allowances here.
		# gtag.js is one exact host. Google's collection hosts are regional and it
		# picks them itself, so connect-src and img-src need its documented masks.
		# PostHog is one host because nothing is lazy-loaded (fe/src/shared/lib/posthog.ts).
		Content-Security-Policy "default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.google-analytics.com https://*.googletagmanager.com; connect-src 'self' https://nbg1.your-objectstorage.com https://o4511050131505152.ingest.de.sentry.io https://cloudflareinsights.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://eu.i.posthog.com; form-action 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"

		# Referrer policy
		Referrer-Policy "strict-origin-when-cross-origin"

		# Permissions policy — disable unused browser features. No embedded payment
		# frame exists (checkout is a redirect), so `payment` needs no allowance.
		Permissions-Policy "camera=(), microphone=(), geolocation=()"

		# Remove server header
		-Server
	}
}

# The API rate-limits on what X-Forwarded-For says, so it must carry the resolved
# client and nothing else. Left alone, Caddy keeps the chain a trusted peer sent,
# and Cloudflare's starts with whatever the caller put in the header: gin, which
# trusts every proxy unless TRUSTED_PROXIES is set, would take that forged entry.
(frontend_upstream) {
	reverse_proxy frontend:80 {
		header_up X-Forwarded-For {client_ip}
	}
}

cursopus.com {
	import security_headers
	import frontend_upstream
}

# www -> apex redirect. Caddy obtains a cert for www so Cloudflare (Full strict)
# does not return 525. Requires the Cloudflare DNS record for www to be proxied
# and pointing at this origin.
www.cursopus.com {
	redir https://cursopus.com{uri} permanent
}

# Legacy domain (Jobber -> Cursopus rename). Pages 301 to the new domain; /api/*
# keeps working because already-installed extension versions have this host
# hard-coded as their API base, and Creem may still deliver webhooks here.
# Remove the /api/* handler only once no traffic reaches it (see
# docs/plans/rebrand-cursopus.md, phase 4).
jobber-app.com {
	import security_headers

	handle /api/* {
		import frontend_upstream
	}

	handle {
		redir https://cursopus.com{uri} permanent
	}
}

www.jobber-app.com {
	redir https://cursopus.com{uri} permanent
}
