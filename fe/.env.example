VITE_API_BASE_URL=http://localhost:8080/api/v1

# Feature flags
VITE_FEATURE_SENTRY=false
VITE_FEATURE_EMAIL_NOTIFICATIONS=true
VITE_FEATURE_PAYMENTS=false
VITE_FEATURE_GA4=false
VITE_FEATURE_POSTHOG=false

