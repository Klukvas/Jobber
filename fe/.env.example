# Google Analytics 4 (requires VITE_FEATURE_GA4=true)
VITE_GA4_MEASUREMENT_ID=

# PostHog (requires VITE_FEATURE_POSTHOG=true)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
